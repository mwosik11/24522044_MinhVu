# Copy to server/.env — never commit the real .env.
# Local MongoDB / Docker:
MONGODB_URI=mongodb://127.0.0.1:27017/dating_without_love
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dating_without_love
PORT=4000
# Tests: reuse a locally installed mongod instead of downloading one (run `which mongod`).
# MONGOMS_SYSTEM_BINARY=/opt/homebrew/bin/mongod